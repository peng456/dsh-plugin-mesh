{
  "name": "dsh-plugin-mesh",
  "version": "0.3.15",
  "type": "module",
  "description": "DSH Mesh：局域网自动发现同网段的 DSH 实例，并可通过内置的 Tailscale 用户态节点跨互联网自组网，双向派发任务。",
  "license": "MIT",
  "author": "peng456",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mesh",
    "lan",
    "multicast",
    "discovery",
    "remote",
    "tailscale",
    "tsnet",
    "tailnet",
    "wireguard"
  ],
  "homepage": "https://github.com/peng456/dsh-plugin-mesh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peng456/dsh-plugin-mesh.git"
  },
  "bugs": {
    "url": "https://github.com/peng456/dsh-plugin-mesh/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "sidecar",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "selftest": "node lib/_selftest-tsnet.mjs",
    "selftest:tsnet": "node lib/_selftest-tsnet.mjs",
    "selftest:live": "node lib/_selftest-tsnet-live.mjs",
    "selftest:tailnet": "node lib/_selftest-tsnet-tailnet.mjs",
    "selftest:lan": "node lib/_selftest-discovery.mjs",
    "check": "node scripts/check-version.mjs && node --check lib/index.js && node --check lib/discovery.js && node --check lib/scan.js && node --check lib/tsnet/download.js && node --check lib/tsnet/manager.js && node --check lib/tsnet/bridge.js && node --check client/client.js",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "verify:mirror": "node scripts/verify-lan-mirror.mjs",
    "check:scope": "python3 tools/scopecheck.py lib/index.js"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-locale": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
