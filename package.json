{
  "name": "dsh-plugin-mesh",
  "version": "0.5.13",
  "type": "module",
  "description": "把跑不完的活交给另一台电脑；跑完，结果回到你面前。两台装了 DSH 的电脑各装一次，自动互相发现，任务派过去由对端的 agent 执行，结果派回来。Hand a long task to another machine: your DSH instances find each other, the peer runs it, and the result comes back. No pairing codes, no IPs, no Tailscale client.",
  "license": "MIT",
  "author": "peng456 (https://github.com/peng456)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-desktop",
    "mesh",
    "remote",
    "multi-machine",
    "long-task",
    "second-machine",
    "lan",
    "tailscale",
    "tailnet",
    "discovery"
  ],
  "homepage": "https://github.com/peng456/dsh-plugin-mesh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peng456/dsh-plugin-mesh.git"
  },
  "bugs": {
    "url": "https://github.com/peng456/dsh-plugin-mesh/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "README.en.md",
    "AGENTS.md",
    "llms.txt",
    "lib",
    "client",
    "sidecar",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "install.sh"
  ],
  "scripts": {
    "selftest": "node lib/_selftest-tsnet.mjs",
    "selftest:tsnet": "node lib/_selftest-tsnet.mjs",
    "selftest:live": "node lib/_selftest-tsnet-live.mjs",
    "selftest:tailnet": "node lib/_selftest-tsnet-tailnet.mjs",
    "selftest:lan": "node lib/_selftest-discovery.mjs",
    "selftest:client": "node lib/_selftest-client.mjs",
    "selftest:prompt": "node lib/_selftest-prompt.mjs",
    "selftest:caps": "node lib/_selftest-capabilities.mjs",
    "selftest:newsession": "node lib/_selftest-newsession.mjs",
    "selftest:release": "node scripts/_selftest-release-plan.mjs",
    "selftest:reply": "node --experimental-vm-modules lib/_selftest-reply-route.mjs",
    "selftest:resume": "node --experimental-vm-modules lib/_selftest-resume.mjs",
    "selftest:persist": "node lib/_selftest-persist.mjs",
    "selftest:reasoning": "node lib/_selftest-reasoning.mjs",
    "selftest:layout": "node lib/_selftest-layout.mjs",
    "selftest:diagnostics": "node lib/_selftest-diagnostics.mjs",
    "selftest:osinfo": "node lib/_selftest-osinfo.mjs",
    "selftest:update": "node lib/_selftest-update.mjs",
    "selftest:upgrade": "node lib/_selftest-upgrade.mjs",
    "selftest:approval": "node lib/_selftest-approval.mjs",
    "test": "npm run check && npm run selftest && npm run selftest:prompt && npm run selftest:at && npm run selftest:at:host && npm run selftest:pairing && npm run selftest:approval && npm run selftest:switch && npm run selftest:client && npm run selftest:caps && npm run selftest:release && npm run selftest:reply && npm run selftest:reasoning && npm run selftest:resume && npm run selftest:persist && npm run selftest:layout && npm run selftest:diagnostics && npm run selftest:osinfo && npm run selftest:peerweb && npm run selftest:update && npm run selftest:upgrade",
    "check": "node scripts/check-version.mjs && node scripts/check-tdz.mjs && node --check lib/index.js && node --check lib/layout.js && node --check lib/discovery.js && node --check lib/conversation.js && node --check lib/identity.js && node --check lib/capabilities.js && node --check lib/prompt.js && node --check lib/at-mention.js && node --check lib/pairing.js && node --check lib/switch.js && node --check lib/scan.js && node --check lib/update.js && node --check lib/upgrade.js && node --check lib/peer-web.js && node --check lib/tsnet/download.js && node --check lib/tsnet/manager.js && node --check lib/tsnet/bridge.js && node --check lib/tsnet/channels.js && node --check client/client.js && node --check scripts/release-plan.mjs && npm run check:loadable && npm run check:docs",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "verify:mirror": "node scripts/verify-lan-mirror.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release-plugin": "bash scripts/release-plugin.sh",
    "check:loadable": "node scripts/check-loadable.mjs --allow-missing-runtime-dep",
    "check:deploy": "node scripts/check-loadable.mjs",
    "check:scope": "python3 tools/scopecheck.py lib/index.js",
    "prepublishOnly": "npm test && node scripts/check-tarball.mjs",
    "check:docs": "node scripts/sync-llms.mjs",
    "selftest:pairing": "node lib/_selftest-pairing.mjs",
    "selftest:switch": "node lib/_selftest-switch.mjs",
    "selftest:at": "node lib/_selftest-at-mention.mjs",
    "selftest:at:host": "node --experimental-vm-modules lib/_selftest-at-mention-host.mjs",
    "selftest:peerweb": "node lib/_selftest-peer-web.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-locale": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  }
}
