{
  "name": "dsh-plugin-mesh",
  "version": "0.5.4-dshgo.9",
  "type": "module",
  "description": "DSH Mesh：局域网自动发现同网段的 DSH 实例、显示每台机器上报的能力，并双向派发任务；可用内置的用户态 Tailscale 节点跨互联网组网。Discovers other DSH instances on the LAN, shows the capabilities each one reports, and dispatches tasks between machines in both directions, with an optional userspace Tailscale node for links across networks.",
  "license": "MIT",
  "author": "peng456 (https://github.com/peng456)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-desktop",
    "mesh",
    "lan",
    "multicast",
    "discovery",
    "remote",
    "tailscale",
    "tsnet",
    "tailnet",
    "wireguard"
  ],
  "homepage": "https://github.com/peng456/dsh-plugin-mesh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peng456/dsh-plugin-mesh.git"
  },
  "bugs": {
    "url": "https://github.com/peng456/dsh-plugin-mesh/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "README.en.md",
    "AGENTS.md",
    "llms.txt",
    "lib",
    "client",
    "sidecar",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "install.sh"
  ],
  "scripts": {
    "selftest": "node lib/_selftest-tsnet.mjs",
    "selftest:tsnet": "node lib/_selftest-tsnet.mjs",
    "selftest:live": "node lib/_selftest-tsnet-live.mjs",
    "selftest:tailnet": "node lib/_selftest-tsnet-tailnet.mjs",
    "selftest:lan": "node lib/_selftest-discovery.mjs --pair",
    "selftest:netinfo": "node lib/_selftest-netinfo.mjs",
    "selftest:usb": "node lib/_selftest-usb.mjs",
    "selftest:usb-integration": "node --experimental-vm-modules lib/_selftest-usb-integration.mjs",
    "selftest:dshgo": "node lib/_selftest-dshgo.mjs",
    "selftest:inbound-preset": "node lib/_selftest-inbound-preset.mjs",
    "selftest:dshgo-ui": "node lib/_selftest-dshgo-ui.mjs",
    "selftest:client": "node lib/_selftest-client.mjs",
    "selftest:prompt": "node lib/_selftest-prompt.mjs",
    "selftest:caps": "node lib/_selftest-capabilities.mjs",
    "selftest:newsession": "node lib/_selftest-newsession.mjs",
    "selftest:release": "node scripts/_selftest-release-plan.mjs",
    "selftest:reply": "node --experimental-vm-modules lib/_selftest-reply-route.mjs",
    "selftest:resume": "node --experimental-vm-modules lib/_selftest-resume.mjs",
    "selftest:persist": "node lib/_selftest-persist.mjs",
    "selftest:reasoning": "node lib/_selftest-reasoning.mjs",
    "selftest:layout": "node lib/_selftest-layout.mjs",
    "selftest:diagnostics": "node lib/_selftest-diagnostics.mjs",
    "selftest:osinfo": "node lib/_selftest-osinfo.mjs",
    "selftest:avatar": "node lib/_selftest-avatar.mjs",
    "test": "npm run check && npm run selftest:netinfo && npm run selftest:dshgo && npm run selftest:inbound-preset && npm run selftest:dshgo-ui && npm run selftest:usb && npm run selftest:usb-integration && npm run selftest && npm run selftest:prompt && npm run selftest:pairing && npm run selftest:client && npm run selftest:caps && npm run selftest:release && npm run selftest:reply && npm run selftest:reasoning && npm run selftest:resume && npm run selftest:persist && npm run selftest:layout && npm run selftest:diagnostics && npm run selftest:avatar && npm run selftest:osinfo",
    "check": "node scripts/check-version.mjs && node scripts/check-tdz.mjs && node --check lib/index.js && node --check lib/netinfo.js && node --check lib/dshgo.js && node --check lib/inbound-preset.js && node --check lib/dshgo-ui.js && node --check lib/usb.js && node --check lib/layout.js && node --check lib/discovery.js && node --check lib/conversation.js && node --check lib/identity.js && node --check lib/capabilities.js && node --check lib/prompt.js && node --check lib/pairing.js && node --check lib/scan.js && node --check lib/tsnet/download.js && node --check lib/tsnet/manager.js && node --check lib/tsnet/bridge.js && node --check lib/tsnet/channels.js && node --check client/client.js && node --check scripts/release-plan.mjs && npm run check:peerdeps && npm run check:registry && npm run check:loadable && npm run check:docs",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "verify:mirror": "node scripts/verify-lan-mirror.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release-plugin": "bash scripts/release-plugin.sh",
    "check:loadable": "node scripts/check-loadable.mjs --allow-missing-runtime-dep",
    "check:deploy": "node scripts/check-loadable.mjs",
    "check:scope": "python3 tools/scopecheck.py lib/index.js",
    "prepublishOnly": "npm test && node scripts/check-tarball.mjs",
    "check:docs": "node scripts/sync-llms.mjs",
    "check:peerdeps": "node scripts/check-peerdeps.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "e2e:android": "node scripts/e2e-android.mjs",
    "selftest:pairing": "node lib/_selftest-pairing.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-locale": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-brand": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "设备互联",
      "en": "Mesh"
    },
    "icon": "team",
    "contributes": {
      "composer.strip": [
        {
          "id": "mesh-status",
          "icon": "team",
          "panel": "peers"
        }
      ],
      "panels": [
        {
          "id": "home",
          "title": {
            "zh": "Mesh",
            "en": "Mesh"
          },
          "icon": "team",
          "placement": [
            "session.tab",
            "features"
          ]
        },
        {
          "id": "peers",
          "title": {
            "zh": "设备",
            "en": "Devices"
          },
          "icon": "team",
          "placement": [
            "session.tab",
            "features"
          ]
        },
        {
          "id": "tasks",
          "title": {
            "zh": "任务",
            "en": "Tasks"
          },
          "icon": "todo",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  }
}
